NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27018/e_learning_platform?replicaSet=elearnLocal
MONGO_TEST_URI=mongodb://127.0.0.1:27018/e_learning_platform_test?replicaSet=elearnLocal
CORS_ORIGINS=http://localhost:5173,http://localhost:5000
BCRYPT_ROUNDS=12
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=e-learning-platform-api
JWT_AUDIENCE=e-learning-platform-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_PEPPER=replace-with-another-32-character-random-secret
REFRESH_TOKEN_TTL_SECONDS=2592000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY_HOPS=0

# Email verification (use a local SMTP catcher in development)
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@example.com
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
PASSWORD_RESET_URL=http://localhost:5173/reset-password
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# Mux Video (never commit provider credentials)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
# PEM may be written on one line using literal \n separators.
MUX_SIGNING_PRIVATE_KEY=
MUX_UPLOAD_CORS_ORIGIN=http://localhost:5173
MUX_UPLOAD_TIMEOUT_SECONDS=3600
MUX_VIDEO_QUALITY=basic
MUX_PLAYBACK_TOKEN_TTL_SECONDS=900
# Existing ready Test/Staging asset used only by npm run providers:proof:live -- --execute
PROVIDER_PROOF_MUX_ASSET_ID=
# Test assets are limited to 10 seconds and removed by Mux after 24 hours.
MUX_TEST_MODE=true

# Cloudinary (signed image uploads and authenticated PDF delivery)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_IMAGE_UPLOAD_PRESET=
CLOUDINARY_ATTACHMENT_UPLOAD_PRESET=
CLOUDINARY_UPLOAD_INTENT_TTL_SECONDS=600
CLOUDINARY_DOWNLOAD_URL_TTL_SECONDS=60
CLOUDINARY_MAX_IMAGE_BYTES=5242880
CLOUDINARY_MAX_ATTACHMENT_BYTES=20971520

# Stripe Test Mode only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_CHECKOUT_EXPIRES_SECONDS=1800
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_API_TIMEOUT_MS=10000

# Per-IP limits for registration and verification-email resend
AUTH_RATE_LIMIT_WINDOW_MS=900000
REGISTER_RATE_LIMIT_MAX=5
VERIFY_RATE_LIMIT_MAX=10
RESEND_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_MAX=60
LOGOUT_RATE_LIMIT_MAX=30
LOGOUT_ALL_RATE_LIMIT_MAX=10
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
RESET_PASSWORD_RATE_LIMIT_MAX=10

# Sprint 2 limiter namespaces (activated by their owning stories)
CHECKOUT_RATE_LIMIT_MAX=5
CHECKOUT_RATE_LIMIT_WINDOW_MS=60000
MEDIA_INTENT_RATE_LIMIT_MAX=10
MEDIA_INTENT_RATE_LIMIT_WINDOW_MS=60000
MEDIA_ACTION_RATE_LIMIT_MAX=30
MEDIA_ACTION_RATE_LIMIT_WINDOW_MS=60000
ENROLL_RATE_LIMIT_MAX=10
ENROLL_RATE_LIMIT_WINDOW_MS=60000
COURSE_REVIEW_RATE_LIMIT_MAX=10
COURSE_REVIEW_RATE_LIMIT_WINDOW_MS=60000
INSTRUCTOR_PROFILE_RATE_LIMIT_MAX=10
INSTRUCTOR_PROFILE_RATE_LIMIT_WINDOW_MS=60000
ADMIN_WRITE_RATE_LIMIT_MAX=30
ADMIN_WRITE_RATE_LIMIT_WINDOW_MS=60000
LEARNING_ACCESS_RATE_LIMIT_MAX=30
LEARNING_ACCESS_RATE_LIMIT_WINDOW_MS=60000
PREVIEW_RATE_LIMIT_MAX=20
PREVIEW_RATE_LIMIT_WINDOW_MS=60000
LEARNING_PROGRESS_RATE_LIMIT_MAX=60
LEARNING_PROGRESS_RATE_LIMIT_WINDOW_MS=60000
PRIVATE_READ_RATE_LIMIT_MAX=120
PRIVATE_READ_RATE_LIMIT_WINDOW_MS=60000
CATALOG_RATE_LIMIT_MAX=120
CATALOG_RATE_LIMIT_WINDOW_MS=60000

# Used only by npm run seed:admin
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
