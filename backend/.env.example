NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/e_learning_platform
MONGO_TEST_URI=mongodb://127.0.0.1:27017/e_learning_platform_test
CORS_ORIGINS=http://localhost:5173,http://localhost:5000
BCRYPT_ROUNDS=12
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=e-learning-platform-api
JWT_AUDIENCE=e-learning-platform-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_PEPPER=replace-with-another-32-character-random-secret
REFRESH_TOKEN_TTL_SECONDS=2592000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY_HOPS=0

# Email verification (use a local SMTP catcher in development)
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@example.com
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# Per-IP limits for registration and verification-email resend
AUTH_RATE_LIMIT_WINDOW_MS=900000
REGISTER_RATE_LIMIT_MAX=5
VERIFY_RATE_LIMIT_MAX=10
RESEND_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_MAX=60

# Used only by npm run seed:admin
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
